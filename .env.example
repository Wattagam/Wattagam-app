# Local development only. Copy to .env and choose your own passwords.
BACKEND_PORT=8080
DB_PORT=13306
MYSQL_DATABASE=wattagam
MYSQL_USER=wattagam
MYSQL_PASSWORD=change-me-local-app
MYSQL_ROOT_PASSWORD=change-me-local-root

# 서버 인증 설정: JWT 키는 openssl rand -base64 32로 생성합니다.
AUTH_JWT_SECRET=
# 카카오 Developers의 숫자 앱 ID입니다. 네이티브 앱 키와 다릅니다.
KAKAO_APP_ID=
